# Copia este archivo como .env y reemplaza los valores entre < >.
# El archivo .env tiene claves: nunca se sube a GitHub (está en .gitignore).

PORT=3000

# Dirección pública de la app (se usa en los enlaces de los correos).
# En local: http://localhost:3000 · En Render: https://<servicio>.onrender.com
URL_APP=http://localhost:3000

# Mismo cluster de Horas (Clustercompensacion), base nueva: bitacora_pagos.
# Usar un usuario propio con readWrite solo sobre bitacora_pagos.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@clustercompensacion.hqfmgjk.mongodb.net/bitacora_pagos?retryWrites=true&w=majority&appName=Clustercompensacion

# Clave para firmar la cookie de sesión. Se puede generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<cadena-aleatoria-larga>

# ---------------------------------------------------------------------------
# Correo. Todos los avisos salen de UN solo remitente.
# Proveedor recomendado: gmail (API de Gmail con la cuenta de la bitácora).
# Sin la configuración del proveedor, los correos quedan "en cola" y no salen.
# ---------------------------------------------------------------------------
CORREO_PROVEEDOR=gmail
CORREO_REMITENTE=<bitacora.pagos.sed@gmail.com>
NOMBRE_REMITENTE=Bitácora de Pagos
# Opcional: a dónde llegan las respuestas (p. ej. la administradora)
CORREO_RESPONDER_A=
# SOLO PRUEBAS: todos los correos llegan a esta dirección en lugar de a los
# usuarios de prueba (que no existen). Dejar vacío en producción.
CORREO_REDIRIGIR_A=

# Gmail: cliente OAuth "App de escritorio" de Google Cloud (ver docs/CORREO_GMAIL.md).
# GMAIL_REFRESH_TOKEN lo escribe solo: npm run autorizar-gmail
GMAIL_CLIENT_ID=<...apps.googleusercontent.com>
GMAIL_CLIENT_SECRET=<GOCSPX-...>
GMAIL_REFRESH_TOKEN=

# Brevo (alternativa; NO llega a los buzones de la Secretaría con remitente @gmail.com)
BREVO_API_KEY=
