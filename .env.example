# Copia este archivo como .env y reemplaza los valores entre < >.
# El archivo .env tiene claves: nunca se sube a GitHub (está en .gitignore).

PORT=3000

# Dirección pública de la app (se usa en los enlaces de los correos).
# En local: http://localhost:3000 · En Render: https://<servicio>.onrender.com
URL_APP=http://localhost:3000

# Mismo cluster de Horas (Clustercompensacion), base nueva: bitacora_pagos.
# Usar un usuario propio con readWrite solo sobre bitacora_pagos.
MONGODB_URI=mongodb+srv://<usuario>:<clave>@clustercompensacion.hqfmgjk.mongodb.net/bitacora_pagos?retryWrites=true&w=majority&appName=Clustercompensacion

# Clave para firmar la cookie de sesión. Se puede generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<cadena-aleatoria-larga>
