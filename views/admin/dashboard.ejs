<%- include('../partials/layout-inicio') %>
<div class="encabezado">
  <div>
    <h2 class="encabezado__titulo">Bienvenid@ <%= usuario.nombre %></h2>
    <p class="encabezado__info">Consolidado del trámite de aprobación de registros de pago en BOGDATA</p>
  </div>
</div>

<div class="admin-stats">
  <div class="card stat">
    <p class="card__titulo">En curso</p>
    <p class="stat__valor"><%= enCurso %> <span><%= enCurso === 1 ? 'Trámite' : 'Trámites' %></span></p>
  </div>
  <div class="card stat">
    <p class="card__titulo">Detenidos más de <%= horasDetenido %> h</p>
    <p class="stat__valor"><%= detenidos %> <span><%= detenidos === 1 ? 'Trámite' : 'Trámites' %></span></p>
  </div>
  <div class="card stat">
    <p class="card__titulo">Liberados este mes</p>
    <p class="stat__valor"><%= liberadosMes %> <span><%= liberadosMes === 1 ? 'Trámite' : 'Trámites' %></span></p>
  </div>
  <div class="card stat">
    <p class="card__titulo">Usuarios activos</p>
    <p class="stat__valor"><%= usuariosActivos %> <span><%= usuariosActivos === 1 ? 'Persona' : 'Personas' %></span></p>
  </div>
</div>

<div class="card tabla-card">
  <div class="tabla-card__cabeza">
    <p class="card__titulo">Trámites en curso</p>
    <a class="tabla__link" href="/tramites">Ver todos los trámites</a>
  </div>
  <%- include('../partials/tablaTramites', { tramites, textoVacio: 'No hay trámites en curso. Aparecerán aquí cuando los revisores empiecen a registrarlos.' }) %>
</div>
<%- include('../partials/layout-fin') %>
