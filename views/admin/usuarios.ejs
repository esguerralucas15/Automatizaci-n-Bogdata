<%- include('../partials/layout-inicio') %>
<div class="encabezado">
  <div>
    <h2 class="encabezado__titulo">Usuarios</h2>
    <p class="encabezado__info">Personas que participan en el trámite y su rol. Cada cambio queda en la bitácora.</p>
  </div>
  <a href="/admin/usuarios/nuevo" class="btn btn--primario btn--mediano">Nuevo usuario</a>
</div>

<% if (ok) { %><div class="aviso aviso--ok"><%= ok %></div><% } %>

<div class="card tabla-card">
  <p class="card__titulo">Personas registradas</p>
  <form class="filtro" method="GET" action="/admin/usuarios">
    <label for="rol" class="filtro__label">Rol</label>
    <div class="select select--pequeno">
      <select id="rol" name="rol" onchange="this.form.submit()">
        <option value="">Todos</option>
        <% roles.forEach(r => { %>
          <option value="<%= r %>" <%= filtros.rol === r ? 'selected' : '' %>><%= nombreRol(r) %></option>
        <% }) %>
      </select>
    </div>
    <noscript><button class="btn btn--primario btn--mediano">Filtrar</button></noscript>
  </form>

  <% if (lista.length) { %>
    <div class="tabla-scroll">
      <table class="tabla">
        <thead>
          <tr><th>Nombre</th><th>Correo</th><th>Cargo</th><th>Rol</th><th>Subsecretaría</th><th>Firmas en curso</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
          <% lista.forEach(u => { %>
            <tr class="<%= u.activo ? '' : 'is-inactivo' %>">
              <td><%= u.nombre %></td>
              <td><%= u._id %></td>
              <td><%= u.cargo || '—' %></td>
              <td><span class="rol rol--<%= u.rol %>"><%= nombreRol(u.rol) %></span></td>
              <td><%= u.subsecretaria || '—' %></td>
              <td><%= u.enCurso === null ? '—' : u.enCurso %></td>
              <td><span class="estado <%= u.activo ? 'estado--finalizado' : 'estado--pendiente' %>"><%= u.activo ? 'Activo' : 'Inactivo' %></span></td>
              <td><a class="tabla__link" href="/admin/usuarios/<%= encodeURIComponent(u._id) %>">Editar</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="vacio">No hay usuarios con este filtro.</p>
  <% } %>
</div>

<div class="card tabla-card historial">
  <p class="card__titulo">Reciben copia (sin cuenta)</p>
  <% if (copias.length) { %>
    <div class="tabla-scroll">
      <table class="tabla">
        <thead><tr><th>Nombre o área</th><th>Correo</th><th>Recibe (según el área)</th><th>Copia en</th><th>Trámites de</th></tr></thead>
        <tbody>
          <% copias.forEach(c => { %>
            <tr><td><%= c.nombre || '—' %></td><td><%= c.correo %></td><td><%= c.recibe %></td><td><%= c.etapas.join(', ') || '—' %></td><td><%= c.subsecretaria || 'Todas las subsecretarías' %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="vacio">No hay destinatarios de copia configurados.</p>
  <% } %>
</div>
<%- include('../partials/layout-fin') %>
