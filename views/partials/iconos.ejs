<% } else if (icono === 'mas') { %><svg <%- svg %>><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
<% } else if (icono === 'salir') { %><svg <%- svg %>><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
