<%
  const enlaces = usuario.rol === 'admin'
    ? [
        { href: '/admin/dashboard', texto: 'Dashboard', icono: 'casa' },
        { href: '/tramites', texto: 'Trámites', icono: 'lista', exacta: true },
        { href: '/admin/tiempos', texto: 'Tiempos de respuesta', icono: 'reloj' },
        { href: '/admin/bitacora', texto: 'Bitácora', icono: 'escudo' },
        { href: '/admin/usuarios', texto: 'Usuarios', icono: 'personas' },
      ]
    : [
        { href: '/bandeja', texto: 'Mi bandeja', icono: 'bandeja' },
        ...(usuario.rol === 'revisor' ? [{ href: '/tramites/nuevo', texto: 'Nuevo trámite', icono: 'mas' }] : []),
        { href: '/tramites', texto: 'Trámites', icono: 'lista', exacta: true },
      ];
  const actual = rutaActual;
%>
<aside class="sidebar" id="sidebar">
  <div>
    <div class="sidebar__perfil">
      <p class="sidebar__nombre"><%= usuario.nombre %></p>
      <p class="sidebar__rol"><%= nombreRol(usuario.rol) %></p>
    </div>
    <nav class="sidebar__nav">
      <% enlaces.forEach(e => { %>
        <a href="<%= e.href %>" class="sidebar__link <%= (e.exacta ? actual === e.href || (actual.startsWith('/tramites/') && actual !== '/tramites/nuevo') : actual.startsWith(e.href)) ? 'is-active' : '' %>">
          <%- include('iconos', { icono: e.icono }) %>
          <span><%= e.texto %></span>
        </a>
      <% }) %>
    </nav>
  </div>
  <form action="/logout" method="POST" class="sidebar__salir">
    <button type="submit" class="sidebar__link">
      <%- include('iconos', { icono: 'salir' }) %>
      <span>Cerrar sesión</span>
    </button>
  </form>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
