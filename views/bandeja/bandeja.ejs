<%- include('../partials/layout-inicio') %>
<div class="encabezado">
  <div>
    <h2 class="encabezado__titulo">Bienvenid@ <%= usuario.nombre %></h2>
    <p class="encabezado__info"><%= nombreRol(usuario.rol) %> · Trámites que esperan tu registro</p>
  </div>
  <% if (usuario.rol === 'revisor') { %><a href="/tramites/nuevo" class="btn btn--primario btn--mediano">Nuevo trámite</a><% } %>
</div>

<div class="admin-stats admin-stats--tres">
  <div class="card stat">
    <p class="card__titulo">Pendientes de mi registro</p>
    <p class="stat__valor"><%= pendientes.length %> <span><%= pendientes.length === 1 ? 'Trámite' : 'Trámites' %></span></p>
  </div>
  <div class="card stat">
    <p class="card__titulo">En curso</p>
    <p class="stat__valor"><%= enCurso %> <span><%= enCurso === 1 ? 'Trámite' : 'Trámites' %></span></p>
  </div>
  <div class="card stat">
    <p class="card__titulo">Mayor tiempo en espera</p>
    <p class="stat__valor"><%= pendientes.length ? esperaDe(Math.max(...pendientes.map(t => t.horasEspera))) : '—' %></p>
  </div>
</div>

<div class="card tabla-card">
  <p class="card__titulo">Mi bandeja</p>
  <%- include('../partials/tablaTramites', { tramites: pendientes, textoVacio: 'No tienes trámites pendientes. Cuando alguien registre un paso que te corresponda, te llegará un correo y aparecerá aquí.' }) %>
</div>
<%- include('../partials/layout-fin') %>
