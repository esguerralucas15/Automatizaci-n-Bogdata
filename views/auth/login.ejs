<%- include('../partials/head') %>
<body class="login">
  <div class="login__diagonal" aria-hidden="true"></div>
  <main class="login__contenido">
    <img class="login__logo" src="/img/logo.png" alt="Secretaría de Educación">
    <h1 class="login__titulo">Bitácora de Trámites de Pago</h1>
    <form class="login__form" action="/login" method="POST" novalidate>
      <label for="correo" class="login__label">Ingresa tu Correo Institucional</label>
      <input class="login__input <%= error ? 'is-error' : '' %>" type="email" id="correo" name="correo"
        autocomplete="email" autocapitalize="none" spellcheck="false" placeholder="Correo institucional" value="<%= correo %>" required autofocus>
      <p class="login__error" role="alert"><%= error || '' %></p>
      <button type="submit" class="btn btn--primario">Ingresar</button>
    </form>
  </main>
</body>
</html>
